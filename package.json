{
  "name": "licenzia",
  "version": "1.0.0",
  "homepage": "https://coy123.github.io/licenzia",
  "description": "Licenzia",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "serve:static": "serve out --listen 3000 --no-port-switching",
    "cy:open": "cypress open --e2e --browser electron",
    "cy:run": "cypress run --e2e",
    "cy:run:static": "cypress run --e2e --env staticExport=true",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cy:run",
    "test:e2e:static": "start-server-and-test serve:static http://localhost:3000 cy:run:static",
    "test:e2e:open": "start-server-and-test dev http://localhost:3000 cy:open"
  },
  "type": "module",
  "engines": {
    "node": ">=20.1.0"
  },
  "dependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "25.0.10",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.19.0",
    "postcss": "^8.5.6",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^3.4.17",
    "terser": "^5.37.0",
    "typescript": "^5.5.3"
  },
  "private": true
}
